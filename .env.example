# Produktiv-Domain ohne Slash am Ende. Steuert Canonicals, Sitemap, robots.txt, llms.txt und Schema.org-URLs.
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# Newsletter (optional): Brevo-Formular-URL aus Brevo → Kontakte → Formulare (Double-Opt-in), z. B.
# https://xxxx.sibforms.com/serve/MUIF... Gesetzt zeigen LeadBox, LeadMagnetBox, SlideInLead und EmailCapture
# den Anmelde-Link und /datenschutz den Brevo-Abschnitt. Leer = YouTube-Abo als Ersatz.
# Im Pages-Workflow als Repository-Variable NEWSLETTER_URL setzen.
NEXT_PUBLIC_NEWSLETTER_URL=

# Postfach für mailto-Links (z. B. /werben). Leer = hello@mentat.codes. Repository-Variable CONTACT_EMAIL.
NEXT_PUBLIC_CONTACT_EMAIL=
