# Produktiv-Domain ohne Slash am Ende. Steuert Canonicals, Sitemap, robots.txt, llms.txt und Schema.org-URLs.
NEXT_PUBLIC_SITE_URL=https://deine-domain.de

# Newsletter PromptGott: ohne Wert gilt https://promptgott.mentat.codes/newsletter/ (universelle Einstiegsadresse, Fallback in lib/monetization.js).
# Alle Lead-Bausteine (LeadBox, LeadMagnetBox, SlideInLead, EmailCapture) verlinken dann .../subscribe.
# Optional eine andere URL, z. B. ein Brevo-Formular (https://xxxx.sibforms.com/serve/...), das direkt verlinkt wird.
# Im Pages-Workflow als Repository-Variable NEWSLETTER_URL setzen.
NEXT_PUBLIC_NEWSLETTER_URL=https://promptgott.mentat.codes/newsletter/

# Download-Sperre (optional): 1 = gesperrte Downloads (Prompt-Paket, Top-50-CSV) gibt es nur per Newsletter-Willkommensmail.
# Leer = alle Downloads frei, daneben der Button „PromptGott abonnieren“. Erst setzen, wenn die Willkommensmail
# die Download-Links nachweislich enthält. Repository-Variable NEWSLETTER_GATE.
NEXT_PUBLIC_NEWSLETTER_GATE=

# Postfach für mailto-Links (z. B. /werben). Leer = hello@mentat.codes. Repository-Variable CONTACT_EMAIL.
NEXT_PUBLIC_CONTACT_EMAIL=
